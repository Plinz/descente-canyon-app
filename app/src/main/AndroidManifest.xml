<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Public photo export on Android 8/9 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- GPS for approach trail navigation and nearby canyons -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Runtime permission required on Android 13+ for alert delivery -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Puts back the notification of the outing under way after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

     <application
        android:name=".DescenteCanyonApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DescenteCanyon"
        tools:targetApi="36">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DescenteCanyon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Canyon pages of descente-canyon.com can be opened with the app (not an App Link:
                 the domain is not ours, so it cannot be verified). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.descente-canyon.com" />
                <data android:host="descente-canyon.com" />
                <data android:pathPrefix="/canyoning/canyon/" />
            </intent-filter>
        </activity>

        <!-- Opened from the launcher shortcut and the outing notification, over the lock screen too:
             position and numbers are readable without unlocking. Its own task, so "back" returns to
             where the user was. -->
        <activity
            android:name=".ui.EmergencyActivity"
            android:exported="false"
            android:label="@string/emergency_title"
            android:showWhenLocked="true"
            android:taskAffinity="${applicationId}.emergency"
            android:theme="@style/Theme.DescenteCanyon"
            tools:targetApi="27" />

        <receiver
            android:name=".outing.OutingRestoreReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
