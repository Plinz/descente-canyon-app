[Unit]
Description=Debit estimates of the Descente-Canyon server, four times a day

[Timer]
# 00:20 UTC: the estimates of the new day (01:20 or 02:20 in Paris), so that the phones preparing an
# early outing do not compute them themselves before the morning run;
# 06:40 UTC: after Météo-France's morning files (about 05:45-05:56 UTC) and ECMWF's 00 UTC run;
# 12:40 and 18:40 UTC: the following IFS runs and the reports of the day.
OnCalendar=*-*-* 00:20:00 UTC
OnCalendar=*-*-* 06,12,18:40:00 UTC
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
