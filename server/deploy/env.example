# Copy to /srv/dc/env (chmod 600). Read by the api and jobs containers.
# Secret mixed into the hashes of installation keys and networks: openssl rand -hex 32
DC_PEPPER=
# Manifest signing key (ECDSA P-256, PKCS#8 PEM), created on your PC and copied here (README, step 4).
DC_SIGNING_KEY=/srv/dc/secrets/manifest-key.pem
DC_DATA_DIR=/srv/dc/data
DC_PUBLISH_DIR=/srv/dc/publish
DC_REPO_DIR=/srv/dc/repo
# Every sheet of the site is read again once per this many days (about 1,300 requests a night at 14).
DC_ROTATION_DAYS=14
DC_REQUEST_DELAY_S=1.0
DC_USER_AGENT=DescenteCanyonAppServer/1.0 (+https://plinz.github.io/descente-canyon-app/)
# Ping URL of a check on healthchecks.io (optional): alerts by e-mail when the job fails or does not run.
DC_HEALTHCHECKS_URL=
