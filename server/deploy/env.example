# Copy to /srv/dc/env (chmod 600). Read by the api and jobs containers.
# Secret mixed into the hashes of installation keys and networks: openssl rand -hex 32
DC_PEPPER=
# Manifest signing key (ECDSA P-256, PKCS#8 PEM), created on your PC and copied here (README, step 4).
DC_SIGNING_KEY=/srv/dc/secrets/manifest-key.pem
DC_DATA_DIR=/srv/dc/data
DC_PUBLISH_DIR=/srv/dc/publish
DC_REPO_DIR=/srv/dc/repo
# Every sheet of the site is read again once per this many days (about 1,300 requests a night at 14).
DC_ROTATION_DAYS=14
DC_REQUEST_DELAY_S=1.0
DC_USER_AGENT=DescenteCanyonAppServer/1.0 (+https://plinz.github.io/descente-canyon-app/)
# Ping URL of a check on healthchecks.io (optional): alerts by e-mail when the job fails or does not run.
DC_HEALTHCHECKS_URL=
# Same for the debit estimates job (a second check: it runs four times a day, at 00:20, 06:40,
# 12:40 and 18:40 UTC: set the check's period to 6 hours).
DC_HEALTHCHECKS_PREDICTIONS_URL=
# Debit estimates job: Open-Meteo calls a day (the free plan allows 10,000; about 3,100 a day once
# every cell is filled, the first days fill the 400-day windows), the calls the filling leaves for the
# forecasts of the later runs of the day, and the debit pages read per run.
DC_OPENMETEO_DAILY_CALLS=9000
DC_OPENMETEO_RESERVE=2500
DC_DEBIT_PAGES_PER_RUN=200
# Token of the review tool of the proposed canyons (server/README.md, « Relire les canyons proposés »):
# openssl rand -hex 24. Without it the tool refuses every request.
DC_ADMIN_TOKEN=
