# Copy to server/deploy/.env on the server. Read by docker compose itself.
# Domain of the server: its API and the links the app shares (canyon pages, shared outings). The app
# names it twice: dc.backendUrl (https://<domain>) and dc.linkHost (app/build.gradle.kts, dc-app.fr
# by default).
DC_DOMAIN=dc-app.fr
DC_ACME_EMAIL=you@example.org
# uid and gid of the dc account (id dc)
DC_UID=1000
DC_GID=1000
