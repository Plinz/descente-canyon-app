# Copy to server/deploy/.env on the server. Read by docker compose itself.
DC_DOMAIN=api.example.org
# Domain of the links the app shares (canyon pages, shared outings), dc-app.fr when empty. Caddy
# answers on it too. It must be the app's dc.linkHost (app/build.gradle.kts), whose default is the same.
DC_LINK_DOMAIN=
DC_ACME_EMAIL=you@example.org
# uid and gid of the dc account (id dc)
DC_UID=1000
DC_GID=1000
