# Copy to /srv/dc/backup.env (chmod 600).
# Hetzner Storage Box over SFTP, for example: sftp:u123456@u123456.your-storagebox.de:/dc
# or any S3-compatible bucket: s3:https://s3.gra.io.cloud.ovh.net/<bucket>/dc
RESTIC_REPOSITORY=
# File holding the restic password (keep a copy outside the server: without it, no restore).
RESTIC_PASSWORD_FILE=/srv/dc/secrets/restic-password
# Optional healthchecks.io ping URL of the backup check
HEALTHCHECKS_BACKUP_URL=
